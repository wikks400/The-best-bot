# ==========================================
# BOTKEEP & DISCORD BOT CONFIGURATION
# NFT Mint & Buy Tracker Bot
# ==========================================

# 1. Discord Bot Credentials (https://discord.com/developers/applications)
# Required for running the Discord bot and registering slash commands.
# Either DISCORD_TOKEN or DISCORD_BOT_TOKEN is accepted.
DISCORD_TOKEN=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# Optional: Set DISCORD_GUILD_ID to register slash commands instantly to a single server for testing
DISCORD_GUILD_ID=

# 2. Discord Alerts Destination
# Channel ID where NFT alerts are posted (can also be configured via /alerts-channel in Discord)
DISCORD_CHANNEL_ID=
# Optional: Discord role ID to @mention on alerts (can also be configured via /alerts-role in Discord)
DISCORD_ROLE_ID=
# Optional: Discord Webhook URL for webhook-based alerts (alternative or supplemental to channel ID)
DISCORD_WEBHOOK_URL=

# 3. Server & Storage Settings
# PORT for health check HTTP endpoint (Botkeep containers default to 3000)
PORT=3000
# Database storage path (JSON database storing groups, tracked wallets, and alert history)
DATABASE_PATH=./data/nft-alert.json

# 4. Monitoring Engine Configuration
# Interval in milliseconds between blockchain poll cycles (default: 12000 = 12 seconds)
POLL_INTERVAL_MS=12000
# Alert milestones: comma-separated list of unique wallet counts that trigger alerts (e.g. 3,5,8,15,25 or 1,3,5)
# Set to 1,2,3 or 3,5,8 if you want alerts when 1-3 wallets mint or buy!
ALERT_MILESTONES=3,5,8,15,25

# 5. EVM Blockchain RPC Endpoints (100% Free Public RPCs by default - No Credit Card Needed)
# You can use standard verified public RPCs, or your own dedicated Alchemy / Infura / QuickNode endpoints.
# Primary variables: ETHEREUM_RPC_URL, POLYGON_RPC_URL (backward-compatible aliases also supported)

ETHEREUM_RPC_URL=https://rpc.mevblocker.io
RPC_URL_ETHEREUM=https://rpc.mevblocker.io

POLYGON_RPC_URL=https://1rpc.io/matic
RPC_URL_POLYGON=https://1rpc.io/matic

BASE_RPC_URL=https://mainnet.base.org
RPC_URL_BASE=https://mainnet.base.org

ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc

OPTIMISM_RPC_URL=https://mainnet.optimism.io
RPC_URL_OPTIMISM=https://mainnet.optimism.io

INK_RPC_URL=https://rpc-gel.inkonchain.com
RPC_URL_INK=https://rpc-gel.inkonchain.com

BNB_CHAIN_RPC_URL=https://bsc-dataseed.binance.org
RPC_URL_BSC=https://bsc-dataseed.binance.org

AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc
RPC_URL_AVALANCHE=https://api.avax.network/ext/bc/C/rpc

ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
RPC_URL_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com

# Optional authenticated provider keys (auto-builds authenticated RPCs if custom RPC_URL is unset)
# ALCHEMY_API_KEY=
# INFURA_API_KEY=
# ANKR_API_KEY=

# 6. Optional Block Explorer API Keys (Free Tiers)
# Direct on-chain RPC logs are used if left blank; keys only used for extra verified metadata.
ETHERSCAN_API_KEY=
BASESCAN_API_KEY=

# 7. Optional AI Features
GEMINI_API_KEY=
APP_URL=
